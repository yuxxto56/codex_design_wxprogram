page {
  min-height: 100%;
  background: #fbf8f2;
  color: #1b1c1a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 180rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 213, 221, 0.55), transparent 26%),
    radial-gradient(circle at 92% 30%, rgba(196, 234, 230, 0.42), transparent 24%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.56) 0 25%, transparent 25% 100%),
    #fbf8f2;
}

.soft-card {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 20rpx 54rpx rgba(117, 87, 83, 0.08);
}

.pill-button {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #864e5a;
}

.muted {
  color: #837375;
}

.money {
  font-weight: 800;
  color: #864e5a;
}

.top-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
  color: #c58f9a;
  font-size: 32rpx;
  font-weight: 800;
}

.top-action {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  color: #9a5362;
  font-size: 34rpx;
}

.tape {
  position: absolute;
  width: 82rpx;
  height: 30rpx;
  border-radius: 4rpx;
  opacity: 0.68;
  transform: rotate(10deg);
  background: #c4eae6;
}

.paper-card {
  position: relative;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(103, 82, 76, 0.08);
}
