.budget-card {
  position: relative;
  margin-top: 36rpx;
  padding: 48rpx 40rpx 42rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 44rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(216, 240, 236, 0.68), transparent 30%),
    #fff;
  box-shadow: 0 16rpx 44rpx rgba(92, 84, 82, 0.06);
}

.budget-tape {
  right: 40rpx;
  top: 20rpx;
}

.title {
  color: #864e5a;
  font-size: 40rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 12rpx;
  color: #837375;
  font-size: 24rpx;
  font-weight: 700;
}

.budget-input {
  height: 128rpx;
  margin-top: 34rpx;
  padding: 0 32rpx;
  border-radius: 34rpx;
  background: #f8dadd;
  color: #2f2929;
  font-size: 50rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.tip {
  margin-top: 20rpx;
  color: #837375;
  font-size: 24rpx;
  line-height: 36rpx;
}

.save {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  height: 100rpx;
  margin: 40rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  color: #fff;
  background: #864e5a;
  line-height: normal;
  font-weight: 800;
  box-shadow: 0 14rpx 26rpx rgba(148, 84, 102, 0.22);
}

.save::after {
  border: 0;
}
