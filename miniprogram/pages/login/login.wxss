.login-page {
  min-height: 100vh;
  padding: 54rpx 40rpx 44rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 20% 10%, rgba(255, 183, 197, 0.32), transparent 30%),
    radial-gradient(circle at 90% 55%, rgba(172, 210, 206, 0.34), transparent 35%),
    #fbf9f5;
}

.brand-card {
  margin-top: 4rpx;
  padding: 34rpx 32rpx 26rpx;
  text-align: center;
}

.mascot {
  position: relative;
  width: 276rpx;
  height: 276rpx;
  margin: 34rpx auto 28rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 44%, rgba(255, 255, 255, 0.94) 0 41%, transparent 42%),
    radial-gradient(circle at 50% 52%, #f8dccf 0 59%, #fff8ef 60% 100%);
  box-shadow:
    inset 0 0 0 10rpx rgba(255, 255, 255, 0.9),
    0 22rpx 52rpx rgba(103, 82, 76, 0.11);
}

.mascot-ring {
  position: absolute;
  inset: 28rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 -18rpx 0 rgba(248, 220, 207, 0.62);
}

.bear {
  position: absolute;
  left: 50%;
  bottom: 38rpx;
  width: 154rpx;
  height: 174rpx;
  transform: translateX(-50%);
}

.ear {
  position: absolute;
  top: 2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #fff3ea;
  border: 8rpx solid #9b6760;
  box-sizing: border-box;
  z-index: 1;
}

.ear-left {
  left: 12rpx;
}

.ear-right {
  right: 12rpx;
}

.bear-head {
  position: absolute;
  left: 50%;
  top: 22rpx;
  width: 126rpx;
  height: 112rpx;
  border: 8rpx solid #9b6760;
  border-radius: 54rpx 54rpx 48rpx 48rpx;
  background: #fffaf5;
  transform: translateX(-50%);
  box-sizing: border-box;
  z-index: 2;
}

.bear-body {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 142rpx;
  height: 82rpx;
  border-radius: 54rpx 54rpx 48rpx 48rpx;
  background: #fff0e4;
  transform: translateX(-50%);
  box-shadow: inset 0 -12rpx 0 rgba(244, 202, 183, 0.52);
}

.eye {
  position: absolute;
  top: 42rpx;
  width: 10rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #8a5b55;
}

.eye-left {
  left: 34rpx;
}

.eye-right {
  right: 34rpx;
}

.nose {
  position: absolute;
  left: 50%;
  top: 56rpx;
  width: 16rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8a5b55;
  transform: translateX(-50%);
}

.mouth {
  position: absolute;
  top: 65rpx;
  width: 18rpx;
  height: 14rpx;
  border-bottom: 5rpx solid #8a5b55;
  border-radius: 0 0 18rpx 18rpx;
}

.mouth-left {
  left: 45rpx;
}

.mouth-right {
  right: 45rpx;
}

.blush {
  position: absolute;
  top: 62rpx;
  width: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 166, 183, 0.62);
}

.blush-left {
  left: 14rpx;
}

.blush-right {
  right: 14rpx;
}

.coin {
  position: absolute;
  left: 64rpx;
  bottom: 48rpx;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 50%;
  background: #f2d36b;
  color: #9a5362;
  font-size: 28rpx;
  font-weight: 900;
}

.brand {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffa6b7;
  color: #8a4658;
  font-size: 24rpx;
  font-weight: 800;
  transform: rotate(-7deg);
}

.title {
  margin-top: 22rpx;
  color: #864e5a;
  font-size: 48rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 14rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #f8dadd;
  color: #514345;
  font-size: 26rpx;
  line-height: 38rpx;
}

.wechat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 360rpx;
  height: 104rpx;
  margin: 28rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  line-height: normal;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.wechat-button::after {
  border: 0;
}

.wechat-button {
  color: #fff;
  background: #07c160;
  box-shadow: 0 14rpx 30rpx rgba(7, 193, 96, 0.2);
}

.button-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

.login-tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 42rpx;
}

.tool-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 116rpx;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  line-height: normal;
  text-align: center;
  box-sizing: border-box;
}

.tool-card::after {
  border: 0;
}

.help-card {
  background: #efe5aa;
  color: #665f34;
}

.guide-card {
  background: #acd2ce;
  color: #385b58;
}

.tool-title {
  font-size: 26rpx;
  font-weight: 800;
}

.tool-desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
  opacity: 0.72;
}

.help-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 24rpx 28rpx;
  box-sizing: border-box;
  background: rgba(72, 58, 61, 0.32);
}

.help-sheet {
  width: 100%;
  max-height: 82vh;
  padding: 18rpx 30rpx 30rpx;
  border-radius: 36rpx;
  background: #fffaf7;
  box-shadow: 0 -18rpx 46rpx rgba(98, 73, 77, 0.16);
  box-sizing: border-box;
  overflow-y: auto;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #ead9d2;
}

.sheet-title {
  color: #864e5a;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.help-list {
  margin-top: 26rpx;
}

.help-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0e4de;
}

.help-question {
  display: block;
  color: #5b4a4e;
  font-size: 27rpx;
  font-weight: 800;
}

.help-answer {
  display: block;
  margin-top: 10rpx;
  color: #7d7070;
  font-size: 24rpx;
  line-height: 36rpx;
}

.contact-button,
.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  line-height: normal;
  font-size: 27rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.contact-button::after,
.sheet-close::after {
  border: 0;
}

.contact-button {
  color: #385b58;
  background: #d7ede9;
}

.sheet-close {
  color: #ffffff;
  background: #ffa6b7;
}
